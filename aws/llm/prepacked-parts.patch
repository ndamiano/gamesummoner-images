+class _PackParts:
+    """A pack is one flat file, or a directory of equal-sized parts beside it
+    (`<key>.parts/NNNN`, sizes in `<key>.parts/index.json`) that a downloader is
+    still filling in order. A part is ready once it has its full size; a read
+    that lands on a part not there yet waits for it, so the restore trails the
+    download instead of following it."""
+
+    def __init__(self, bin_path: Path):
+        self.bin_path = bin_path
+        self.dir = bin_path.with_suffix(".parts")
+        index = self.dir / "index.json"
+        self.split = index.is_file() and not bin_path.is_file()
+        if self.split:
+            spec = json.loads(index.read_text())
+            self.part_bytes = int(spec["part_bytes"])
+            self.total = int(spec["total_bytes"])
+        self.wait_seconds = float(os.getenv("SGLANG_PREPACKED_PART_TIMEOUT", "900"))
+        self._ready = set()
+        self.consume = self.split and os.getenv("SGLANG_PREPACKED_CONSUME") == "1"
+        self._pending = {}
+        self._lock = __import__("threading").Lock()
+
+    def account(self, chunks):
+        """Count the chunks touching each part, so a part can be deleted once consumed."""
+        if not self.consume:
+            return
+        for _, file_off, _, length in chunks:
+            for part in range(file_off // self.part_bytes, (file_off + length - 1) // self.part_bytes + 1):
+                self._pending[part] = self._pending.get(part, 0) + 1
+
+    def done(self, file_off, length):
+        if not self.consume:
+            return
+        for part in range(file_off // self.part_bytes, (file_off + length - 1) // self.part_bytes + 1):
+            with self._lock:
+                self._pending[part] -= 1
+                gone = self._pending[part] == 0
+            if gone:
+                try:
+                    os.unlink(self.path(part))
+                except FileNotFoundError:
+                    pass
+
+    def path(self, part: int) -> Path:
+        return self.bin_path if part < 0 else self.dir / f"{part:04d}"
+
+    def locate(self, file_off: int):
+        """(part, offset within it, bytes readable from there), waiting for the part."""
+        if not self.split:
+            return -1, file_off, 1 << 62
+        part = file_off // self.part_bytes
+        expected = min(self.part_bytes, self.total - part * self.part_bytes)
+        if part not in self._ready:
+            path = self.path(part)
+            deadline = time.monotonic() + self.wait_seconds
+            while True:
+                try:
+                    if os.path.getsize(path) >= expected:
+                        break
+                except FileNotFoundError:
+                    pass
+                if time.monotonic() > deadline:
+                    raise TimeoutError(f"pack part {path} never arrived")
+                time.sleep(0.05)
+            self._ready.add(part)
+        part_off = file_off - part * self.part_bytes
+        return part, part_off, expected - part_off
+
